<Window x:Class="HeadDown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HeadDown"
        Width="420"
        Height="540"
        MinWidth="390"
        MinHeight="470"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#0B0D12"
        Foreground="#F0F2F7"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191D26"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#363D4C"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#96A0B4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6C63FF"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#242936"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F0F2F7"/>
            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="#3B4354"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303747"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#596277"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#171B23"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LockButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2D965A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="11"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F2F7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="#10131A"
                                    BorderBrush="#566074"
                                    BorderThickness="1"/>
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Width="10"
                                  Height="8"
                                  HorizontalAlignment="Left"
                                  Margin="3,0,0,0"
                                  VerticalAlignment="Center"
                                  Data="M 0 4 L 3.5 7.5 L 10 0"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#938DFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F0F2F7"/>
            <Setter Property="Background" Value="#10131A"/>
            <Setter Property="BorderBrush" Value="#4A5264"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB2C2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#282D38"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#0F1117" BorderBrush="#303747" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="18,18,0,0"/>

            <Grid Grid.Row="1" Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HeadDown" FontSize="20" FontWeight="SemiBold"/>
                        <Border Margin="9,3,0,0"
                                Padding="7,2"
                                Height="21"
                                CornerRadius="10"
                                Background="#24213D">
                            <TextBlock Text="v1.2" Foreground="#938DFF" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Rest without accidental input"
                               Margin="1,1,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="—" Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"/>
                <Button Grid.Column="2" x:Name="CloseButton" Content="×" Style="{StaticResource CaptionButton}" Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,6,16,15">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,11"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="StatusText"
                                       Text="Keyboard ready"
                                       Foreground="#74E297"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <Button x:Name="LockButton"
                                    Content="LOCK KEYBOARD"
                                    Height="52"
                                    Margin="0,10,0,7"
                                    Style="{StaticResource LockButton}"
                                    Click="LockButton_Click"/>
                            <TextBlock x:Name="TimerDisplayText"
                                       Text="Timer: off"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusDetailText"
                                       Text="Mouse stays active. Closing the app also unlocks it."
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,10"
                            Margin="0,0,0,10">
                        <StackPanel x:Name="SessionOptionsPanel">
                            <TextBlock Text="SESSION OPTIONS"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,9"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="TimerEnabledCheckBox"
                                          IsChecked="True"
                                          Content="Silent heads-down timer"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="TimerEnabledCheckBox_Changed"
                                          Unchecked="TimerEnabledCheckBox_Changed"/>
                                <TextBox x:Name="TimerMinutesTextBox"
                                         Grid.Column="1"
                                         Text="20"
                                         Height="27"
                                         MaxLength="3"
                                         Style="{StaticResource TimerTextBox}"
                                         PreviewTextInput="TimerMinutesTextBox_PreviewTextInput"/>
                                <TextBlock Grid.Column="2"
                                           Text="min"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="5,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="FocusCheckBox"
                                          Content="Silence notifications"
                                          IsChecked="True"
                                          ToolTip="Temporarily silence normal Windows toast notifications."
                                          Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="MediaKeysCheckBox"
                                          Grid.Column="1"
                                          Content="Keep media keys"
                                          IsChecked="True"
                                          ToolTip="Allow volume and playback keys while normal typing stays blocked."
                                          Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="EcoCheckBox"
                                          Grid.Row="1"
                                          Content="Use eco mode"
                                          IsChecked="True"
                                          ToolTip="Use Power Saver and dim supported built-in displays."
                                          Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="ScreenOffCheckBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Content="Screen off in 10 sec"
                                          IsChecked="True"
                                          ToolTip="Turn the display off after locking; move the mouse to wake it."
                                          Style="{StaticResource ModernCheckBox}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="BatteryText"
                                               Text="Battery: checking..."
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PowerStateText"
                                               Text="Eco mode: OFF"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="POWER"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="DIM 10%" Height="34" Style="{StaticResource ModernButton}" Click="DimButton_Click"/>
                                <Button Grid.Column="2" Content="SCREEN OFF" Height="34" Style="{StaticResource ModernButton}" Click="ScreenOffButton_Click"/>
                                <Button Grid.Column="4" Content="RESTORE" Height="34" Style="{StaticResource ModernButton}" Click="RestoreButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Text="The mouse always works • Ctrl+Alt+Delete is kept by Windows"
                               Foreground="#727D92"
                               FontSize="9"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
